# =================================================================
# DATABASE
# =================================================================
DATABASE_URL="postgresql://intellispense:intellispense_dev_password@localhost:5432/intellispense_dev?schema=public"

# =================================================================
# REDIS
# =================================================================
REDIS_URL="redis://localhost:6379"

# =================================================================
# JWT AUTHENTICATION
# =================================================================
# IMPORTANT: Generate secure random strings for production
# Example: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-signing-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# =================================================================
# API CONFIGURATION
# =================================================================
API_PORT=4000
API_HOST="localhost"
NODE_ENV="development"
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# =================================================================
# INTEGRATIONS
# =================================================================

# QuickBooks Online
QUICKBOOKS_CLIENT_ID="your-quickbooks-client-id"
QUICKBOOKS_CLIENT_SECRET="your-quickbooks-client-secret"
QUICKBOOKS_REDIRECT_URI="http://localhost:4000/api/integrations/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"  # or "production"

# Anthropic Claude AI
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL_DEFAULT="claude-3-sonnet-20240229"
ANTHROPIC_MAX_TOKENS=4096

# OpenAI (for embeddings)
OPENAI_API_KEY="your-openai-api-key"

# =================================================================
# FILE STORAGE (Digital Ocean Spaces / S3-compatible)
# =================================================================
STORAGE_ENDPOINT="https://nyc3.digitaloceanspaces.com"
STORAGE_REGION="nyc3"
STORAGE_BUCKET="intellispense-dev"
STORAGE_ACCESS_KEY_ID="your-spaces-access-key"
STORAGE_SECRET_ACCESS_KEY="your-spaces-secret-key"

# =================================================================
# MONITORING & OBSERVABILITY
# =================================================================

# Datadog (optional)
DD_API_KEY=""
DD_APP_KEY=""

# Sentry (optional)
SENTRY_DSN=""

# =================================================================
# FEATURE FLAGS
# =================================================================
FEATURE_AI_ENABLED=true
FEATURE_QUICKBOOKS_ENABLED=true
FEATURE_OFFLINE_SYNC_ENABLED=true

# =================================================================
# RATE LIMITING
# =================================================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX_REQUESTS=100
